{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "securechat",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-18",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "securechat-db",
      "database_id": "07bf4e7d-bb37-42ae-ba42-e7a00a20cdad",
      "migrations_dir": "database/d1-migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CHAT_ROOM",
        "class_name": "ChatRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ChatRoom"]
    }
  ],
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": {
    "enabled": true
  },
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "securechat-preview-db",
        "database_id": "ae88705d-afe7-4bf6-bb15-15d68c96f8d7",
        "migrations_dir": "database/d1-migrations"
      }
    ],
    "durable_objects": {
      "bindings": [
        {
          "name": "CHAT_ROOM",
          "class_name": "ChatRoom"
        }
      ]
    }
  }
}
