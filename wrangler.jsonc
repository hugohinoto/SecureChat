{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "securechat",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-18",
  "vars": {
    "APP_DATA_ENCRYPTION_ACTIVE_VERSION": "2",
    "SECURECHAT_CRYPTO_V2_ENABLED": "false"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": [
      "/",
      "/index.html",
      "/admin",
      "/admin/",
      "/admin.html",
      "/bug-report",
      "/bug-report/",
      "/bug-report.html"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "securechat-db",
      "database_id": "07bf4e7d-bb37-42ae-ba42-e7a00a20cdad",
      "migrations_dir": "database/d1-migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CHAT_ROOM",
        "class_name": "ChatRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ChatRoom"
      ]
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  },
  "previews": {
    "durable_objects": {
      "bindings": [
        {
          "name": "CHAT_ROOM",
          "class_name": "ChatRoom"
        }
      ]
    }
  }
}
