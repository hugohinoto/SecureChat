NODE_ENV=development
PORT=3000
# Local PostgreSQL example. Replace with your own local database credentials.
DATABASE_URL=postgresql://securechat_app:replace-this-password@localhost:5432/securechat
# Use a unique random secret (at least 32 bytes); never commit the real value.
APP_DATA_ENCRYPTION_KEY=

# Key rotation: keep APP_DATA_ENCRYPTION_KEY as the legacy v1 key.
# Add APP_DATA_ENCRYPTION_KEY_V2 as a separate secret before activating v2.
# Set APP_DATA_ENCRYPTION_ACTIVE_VERSION=2 only after both v1 and v2 are configured.
APP_DATA_ENCRYPTION_ACTIVE_VERSION=1
