{
  "name": "securechat",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "A privacy-focused chat application prototype on Cloudflare Workers.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "db:migrate": "node scripts/migrate.js",
    "test": "node --test",
    "cf:dev": "npm run build && wrangler dev",
    "cf:deploy": "npm run deploy",
    "cf:d1:create": "wrangler d1 create securechat-db",
    "cf:d1:migrate:local": "wrangler d1 migrations apply DB --local",
    "cf:d1:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "npm run build && npm run cf:d1:migrate:remote && wrangler deploy",
    "build": "node scripts/build-crypto-v2.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pg": "^8.23.1",
    "ws": "^8.18.3",
    "@matrix-org/matrix-sdk-crypto-wasm": "19.0.1"
  },
  "devDependencies": {
    "wrangler": "^4.164.0",
    "esbuild": "0.28.2"
  }
}
